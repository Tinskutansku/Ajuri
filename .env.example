POSTGRES_USER=ajuri
POSTGRES_PASSWORD=ajuri
POSTGRES_DB=ajuri

# Sovelluksen käyttämä yhteysosoite paikallista ajoa varten (ilman Dockeria).
# Portti 5433, koska koneella voi olla jo natiivi PostgreSQL portissa 5432.
# Docker Compose ylikirjoittaa tämän DATABASE_URL:n app-palvelun sisällä (db:5432).
DATABASE_URL=postgresql+asyncpg://ajuri:ajuri@localhost:5433/ajuri

# Nominatim-käyttöehdot vaativat yksilöivän User-Agentin, jossa on
# yhteystieto - vaihda tämä oikeaan ennen tuotantokäyttöä.
# https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=Ajuri/1.0 (+https://github.com/Tinskutansku/Ajuri)
# Esim. "fi" jos tuotanto on varmasti vain kotimainen - oletus tyhjä
# sallii myös ulkomaiset osoitteet (kansainväliset yhteistuotannot).
NOMINATIM_COUNTRYCODES=
